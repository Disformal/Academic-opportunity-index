# ─── AOI Environment Variables ────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env — only .env.example is committed.
# Real secrets (production keys, tokens) go in .env.local — also never committed.
#
# All AOI-specific variables are prefixed AOI_ to prevent collisions.

# ─── Database ─────────────────────────────────────────────────────────────────

# Main application database
# Format: postgresql+psycopg://user:password@host:port/dbname
# Default matches the docker-compose.yml credentials exactly
AOI_DATABASE_URL=postgresql+psycopg://aoi:changeme@localhost:5432/aoi

# Test database — used exclusively by pytest
# Never points at the main database
# Must be set before running any tests
AOI_TEST_DATABASE_URL=postgresql+psycopg://aoi:changeme@localhost:5432/aoi_test

# ─── S3-Compatible Object Store (SeaweedFS) ──────────────────────────────────

# S3-compatible endpoint — matches docker-compose.yml default (SeaweedFS)
AOI_S3_ENDPOINT=http://localhost:8333

# S3 credentials — SeaweedFS does not require authentication by default;
# these are passed to boto3 but ignored by the server.
AOI_S3_ACCESS_KEY=minioadmin
AOI_S3_SECRET_KEY=minioadmin

# Bucket names — created on first write by the application
# Raw HTML/JSON evidence (content-addressed, SHA-256 keyed, zstd compressed)
AOI_S3_BUCKET_EVIDENCE=aoi-evidence

# Extracted plain text (derived from evidence, stored for search/display)
AOI_S3_BUCKET_DERIVED=aoi-derived

# ─── Application ──────────────────────────────────────────────────────────────

# Secret key for FastAPI session signing
# SECURITY: The application refuses to start with this default value when AOI_DEBUG=false.
# Generate a real key: python -c "import secrets; print(secrets.token_urlsafe(64))"
AOI_SECRET_KEY=changeme-in-production-use-a-long-random-string

# Debug mode — enables detailed error pages, auto-reload
# Set to false in production
AOI_DEBUG=true

# Structured log level: DEBUG, INFO, WARNING, ERROR
AOI_LOG_LEVEL=INFO

# ─── Production Only (required by docker-compose.prod.yml) ────────────────────
# These are NOT needed for local development with docker-compose.yml.
# The prod compose file fails to start if these are unset.

# PostgreSQL password — used by the postgres container AND the app's DATABASE_URL.
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=changeme-generate-a-real-password

# Grafana admin password — used by the grafana container.
# Generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=changeme-generate-a-real-password

# ─── Alerting (optional) ─────────────────────────────────────────────────────
# Configure at least one channel (email or webhook) to receive alerts.
# Used by scripts/notify.py and Grafana contact points.

# Email notifications (all required for email alerting to work)
# AOI_ALERT_EMAIL_TO=
# AOI_ALERT_SMTP_HOST=
# AOI_ALERT_SMTP_PORT=587
# AOI_ALERT_SMTP_USER=
# AOI_ALERT_SMTP_PASSWORD=

# Webhook notifications (alternative to email)
# AOI_ALERT_WEBHOOK_URL=

# ─── Crawl Settings (optional overrides) ──────────────────────────────────────

# Maximum requests per second per host (token bucket rate limiter)
# Default is defined in the application; override here to slow down if needed
# AOI_RATE_LIMIT_RPS=1.0

# EURAXESS early-stop threshold (0.0–1.0)
# Fraction of known opportunities on a page before pagination stops
# AOI_EARLY_STOP_THRESHOLD=0.8

# Smokescreen egress proxy (ADR 0023). Every crawler request goes through it;
# it refuses private/internal destinations at connect time.
# Required when AOI_DEBUG=false (fetch refuses to run without it).
# Prod compose sets it to http://smokescreen:4750 automatically.
# For local runs through the dev proxy: docker compose up -d smokescreen
# AOI_EGRESS_PROXY=http://localhost:4750

# ─── Setup Checklist ──────────────────────────────────────────────────────────
#
# Development (local):
#   1. cp .env.example .env
#   2. docker compose up -d
#      (wait ~10 seconds for PostgreSQL and SeaweedFS to become healthy)
#   3. uv sync
#   4. uv run alembic upgrade head
#   5. uv run pytest tests/ -v
#      (all green = environment is working)
#
# Production (VPS):
#   1. cp .env.example .env — set real values for POSTGRES_PASSWORD,
#      GRAFANA_ADMIN_PASSWORD, AOI_SECRET_KEY, and AOI_DEBUG=false
#   2. htpasswd -c nginx/htpasswd aoi_admin
#   3. docker compose -f docker-compose.prod.yml up -d --build
#   4. docker compose -f docker-compose.prod.yml exec app alembic upgrade head
#   5. docker compose -f docker-compose.prod.yml exec app python scripts/seed_sources.py
#
# The test database (aoi_test) is created automatically by
# docker/init-test-db.sql when PostgreSQL first starts (dev compose only).
# Migrations are NOT auto-applied to aoi_test — pytest handles that
# via the rollback fixture in conftest.py.
