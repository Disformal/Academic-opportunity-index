{
  "uid": "aoi-data-quality",
  "title": "Data Quality",
  "description": "Is the data good? What's growing, what's decaying?",
  "tags": ["aoi"],
  "timezone": "browser",
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Opportunities",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "aoi-postgres" },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS total FROM opportunity",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Dedup Clusters",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "postgres", "uid": "aoi-postgres" },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS clusters FROM duplicate_cluster",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "purple", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Open vs Closed",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "postgres", "uid": "aoi-postgres" },
      "targets": [
        {
          "rawSql": "SELECT status AS metric, count(*) AS value FROM opportunity GROUP BY status ORDER BY count(*) DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "pieType": "donut",
        "legend": { "displayMode": "table", "placement": "right" }
      }
    },
    {
      "id": 4,
      "title": "Opportunities by Type",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "postgres", "uid": "aoi-postgres" },
      "targets": [
        {
          "rawSql": "SELECT type, count(*) AS count FROM opportunity GROUP BY type ORDER BY count(*) DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "New Opportunities per Day",
      "description": "Daily count of newly discovered opportunities",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "postgres", "uid": "aoi-postgres" },
      "targets": [
        {
          "rawSql": "SELECT date_trunc('day', first_seen_at) AS time, count(*) AS \"New Opportunities\" FROM opportunity WHERE $__timeFilter(first_seen_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
          },
          "color": { "fixedColor": "green", "mode": "fixed" }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Closures per Day",
      "description": "Daily count of opportunities that were closed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "postgres", "uid": "aoi-postgres" },
      "targets": [
        {
          "rawSql": "SELECT date_trunc('day', closed_at) AS time, count(*) AS \"Closures\" FROM opportunity WHERE closed_at IS NOT NULL AND $__timeFilter(closed_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
          },
          "color": { "fixedColor": "orange", "mode": "fixed" }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Opportunities by Country",
      "description": "Top 20 countries by opportunity count",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "postgres", "uid": "aoi-postgres" },
      "targets": [
        {
          "rawSql": "SELECT country, count(*) AS count FROM opportunity WHERE country IS NOT NULL GROUP BY country ORDER BY count(*) DESC LIMIT 20",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Closure Reasons",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "postgres", "uid": "aoi-postgres" },
      "targets": [
        {
          "rawSql": "SELECT closure_reason AS metric, count(*) AS value FROM opportunity WHERE closure_reason IS NOT NULL GROUP BY closure_reason ORDER BY count(*) DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "legend": { "displayMode": "table", "placement": "right" }
      }
    },
    {
      "id": 9,
      "title": "Deadline Distribution",
      "description": "Upcoming deadlines within the next year",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "datasource": { "type": "postgres", "uid": "aoi-postgres" },
      "targets": [
        {
          "rawSql": "SELECT deadline FROM opportunity WHERE deadline IS NOT NULL AND deadline > now() AND deadline < now() + interval '1 year'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "bucketSize": 7,
        "combine": false
      }
    },
    {
      "id": 10,
      "title": "Provenance Completeness",
      "description": "Field assertion counts and average confidence per field",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "postgres", "uid": "aoi-postgres" },
      "targets": [
        {
          "rawSql": "SELECT field_path, count(*) AS assertions, avg(confidence)::numeric(4,3) AS avg_confidence FROM field_assertion WHERE is_current = true GROUP BY field_path ORDER BY count(*) DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "avg_confidence" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 0.5 },
                    { "color": "green", "value": 0.8 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
